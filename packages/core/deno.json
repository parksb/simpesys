{
  "name": "@simpesys/core",
  "version": "0.6.1-canary.9",
  "license": "GPL-3.0-or-later",
  "exports": "./mod.ts",
  "publish": {
    "exclude": [
      "tests/",
      "cov_profile/"
    ]
  },
  "imports": {
    "@markslides/markdown-it-mermaid": "npm:@markslides/markdown-it-mermaid@^0.3.6",
    "@shikijs/core": "npm:@shikijs/core@^4.4.3",
    "@shikijs/engine-oniguruma": "npm:@shikijs/engine-oniguruma@^4.4.3",
    "@shikijs/langs": "npm:@shikijs/langs@^4.4.3",
    "@shikijs/markdown-it": "npm:@shikijs/markdown-it@^4.4.3",
    "@shikijs/markdown-it/core": "npm:@shikijs/markdown-it@^4.4.3/core",
    "@shikijs/themes": "npm:@shikijs/themes@^4.4.3",
    "shiki": "npm:shiki@^4.0.2",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "es-toolkit": "npm:es-toolkit@^1.43.0",
    "markdown-it": "npm:markdown-it@^14.1.0",
    "markdown-it-anchor": "npm:markdown-it-anchor@^9.2.0",
    "markdown-it-container": "npm:markdown-it-container@^4.0.0",
    "markdown-it-emoji": "npm:markdown-it-emoji@^3.0.0",
    "markdown-it-external-links": "npm:markdown-it-external-links@0.0.6",
    "markdown-it-footnote": "npm:markdown-it-footnote@^4.0.0",
    "markdown-it-html5-embed": "npm:markdown-it-html5-embed@^1.0.0",
    "markdown-it-imsize": "npm:markdown-it-imsize@^2.0.1",
    "markdown-it-inline-comments": "npm:markdown-it-inline-comments@^1.0.1",
    "markdown-it-table-of-contents": "npm:markdown-it-table-of-contents@^1.2.0",
    "markdown-it-task-checkbox": "npm:markdown-it-task-checkbox@^1.0.6",
    "markdown-it-texmath": "npm:markdown-it-texmath@^1.0.0",
    "dayjs": "npm:dayjs@^1.11.13",
    "denque": "npm:denque@^2.1.0",
    "katex": "npm:katex@^0.16.22"
  },
  "test": {
    "include": [
      "tests/**/*.spec.ts"
    ]
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read --allow-write",
    "test:coverage": "deno task test --coverage=cov_profile"
  }
